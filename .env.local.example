# ------------------------------------------------------------------
# Configuração do projeto Firebase (Console > Configurações do projeto
# > Seus apps > App da Web > Configuração do SDK).
#
# Copie este arquivo para ".env.local" e preencha com as SUAS chaves.
# O arquivo ".env.local" NÃO deve ser enviado ao repositório.
# ------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# Credenciais administrativas para rotas do servidor (exclusao de
# mediadores no Firebase Auth). Use uma conta de servico do Firebase.
# Em FIREBASE_ADMIN_PRIVATE_KEY, mantenha os \n exatamente como vierem.
# ------------------------------------------------------------------

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
